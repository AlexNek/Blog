{
  "build": {
    "content": [
      {
        "src": "content",
        "files": [
          "index.md"
        ],
        "dest": "."
      },
      {
        "src": "content/en",
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "dest": "en"
      },
      {
        "src": "content/de",
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "dest": "de"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**/*"
        ],
        "dest": "."
      }
    ],
    "dest": ".",
    "globalMetadata": {
      "_appTitle": "Alex Nek",
      "_appFooter": "© 2026 Alex Nek — All rights reserved · Code: MIT",
      "_appFaviconPath": "images/favicon.svg",
      "_enableSearch": true
    },
    "template": [
      "default",
      "modern"
    ]
  }
}
